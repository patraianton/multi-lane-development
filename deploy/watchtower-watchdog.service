[Unit]
Description=Watchtower Watchdog
Documentation=file:///opt/watchtower/docs/WATCHDOG.md
After=network.target watchtower.service

[Service]
Type=simple
WorkingDirectory=/opt/watchtower
ExecStart=/usr/bin/env node bin/watchdog.mjs run
Restart=always
RestartSec=3
EnvironmentFile=-/etc/watchtower.env
SyslogIdentifier=watchtower-watchdog

[Install]
WantedBy=multi-user.target
